    "shadcn": "catalog:ui"
  },
  "devDependencies": {
    "@syner/eslint": "workspace:*",
    "@syner/prettier": "workspace:*",
    "@syner/typescript": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
