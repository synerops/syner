{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prettier": "@syner/prettier",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
