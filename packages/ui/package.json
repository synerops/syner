{
  "name": "@syner/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "prettier": "@syner/prettier",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui",
    "@phosphor-icons/react": "catalog:ui",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "next-themes": "catalog:ui",
    "tailwind-merge": "catalog:ui",
    "tw-animate-css": "catalog:ui"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@syner/eslint": "workspace:*",
    "@syner/prettier": "workspace:*",
    "@syner/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "next": "catalog:react19",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./branding": "./src/branding/index.ts",
    "./branding/*": "./src/branding/*.ts",
    "./branding/logo": "./src/branding/logo.tsx",
    "./fonts/*": "./src/fonts/*"
  }
}
