{
  "description": "Syner OS - Create apps that work together.",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "typescript": "^5",
      "eslint": "^9",
      "prettier": "^3",
      "@types/node": "^24",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/postcss": "^4.3.3"
    },
    "catalogs": {
      "react19": {
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "next": "16.3.3",
        "@types/react": "^19",
        "@types/react-dom": "^19"
      },
      "ui": {
        "@base-ui/react": "^1.6.0",
        "@phosphor-icons/react": "^2.1.10",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "next-themes": "^0.4.6",
        "shadcn": "^4.11.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
      },
      "ai": {},
      "eve": {}
    }
